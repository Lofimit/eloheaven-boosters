# Public URL the site is served from (no trailing slash)
PUBLIC_URL=https://eloheaven.pw

# REQUIRED. 32+ random chars. Encrypts stored account logins.
# Generate with: openssl rand -hex 32
# Never change it after accounts exist, or their logins become unreadable.
APP_SECRET=

# Discord OAuth (https://discord.com/developers/applications -> OAuth2)
# Redirect URL to register there: ${PUBLIC_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Comma-separated Discord user IDs that always get the Owner role
OWNER_DISCORD_IDS=

# Riot API key (can also be set/rotated from Admin -> Settings)
RIOT_API_KEY=

# Extra origins allowed to POST with cookies, e.g. https://www.eloheaven.pw
EXTRA_ORIGINS=

# --- local dev only ---
# PORT=3000
# DATA_DIR=./server/data
